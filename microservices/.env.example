# ==============================================================================
# FREELANCE MARKETPLACE - MICROSERVICES ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env before running docker compose:
#   cp .env.example .env

# MySQL Root & Application User Configuration
MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=marketplace_user
MYSQL_PASSWORD=marketplace_pass

# Individual Database Names
MYSQL_DB_AUTH=freelance_auth_db
MYSQL_DB_USER=freelance_user_db
MYSQL_DB_GIG=freelance_gig_db
MYSQL_DB_ORDER=freelance_order_db
MYSQL_DB_WALLET=freelance_wallet_db
MYSQL_DB_REVIEW=freelance_review_db

# Host Exposed Ports (Only Gateway & Eureka Dashboard)
API_GATEWAY_PORT=8080
DISCOVERY_SERVER_PORT=8761

# Security / JWT Configuration (256-bit Hex Key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
